; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ru-Pokémon"
config/description="PC-Remake von Pokémon Perl mit Echtzeit-Multiplayer-Overworld."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameData="*res://autoload/game_data.gd"
GameState="*res://autoload/game_state.gd"
SaveSystem="*res://autoload/save_system.gd"
QuestManager="*res://autoload/quest_manager.gd"
NetworkManager="*res://autoload/network_manager.gd"
SceneManager="*res://autoload/scene_manager.gd"
BattleManager="*res://autoload/battle_manager.gd"
DialogueManager="*res://autoload/dialogue_manager.gd"
EvolutionManager="*res://autoload/evolution_manager.gd"
MartManager="*res://autoload/mart_manager.gd"
NameEntryManager="*res://autoload/name_entry_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
TransitionManager="*res://autoload/transition_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

